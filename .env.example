# Frontend Vite Build Configuration
FRONTEND_URL=http://localhost:5173

# Supabase Authentication & Database
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Web Push / VAPID Configuration (Required - get from web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@bharatlingo.in
VITE_VAPID_PUBLIC_KEY=

# Optional server-side generative AI tutor
# Keep this key server-side. Never prefix it with VITE_.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_MAX_OUTPUT_TOKENS=300
